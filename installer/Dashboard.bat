@echo off
rem Opens the HRSystem Dashboard in the browser. Its address is in dashboard-url.txt (the dashboard picks a free port itself).
rem If it is not running it is started (as administrator, one Windows prompt) and then opened.
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$root = '%~dp0'.TrimEnd([char]92); $f = Join-Path $root 'dashboard-url.txt'; function Up { if (-not (Test-Path $f)) { return $false }; try { $u = (Get-Content $f -Raw).Trim(); $null = Invoke-WebRequest -UseBasicParsing -Uri $u -TimeoutSec 3; return $true } catch { return $false } }; if (-not (Up)) { $m = Join-Path $root 'manager'; if (-not (Test-Path (Join-Path $m 'server.mjs'))) { $alt = $null; foreach ($n in 'HRSystem','HRSystem-Dashboard') { try { $t = Get-ScheduledTask -TaskName $n -ErrorAction Stop; $x = ($t.Actions | ForEach-Object { $_.Execute + ' ' + $_.Arguments }) -join ' '; $mm = [regex]::Match($x, '([A-Za-z]:\\[^ ]*?)\\(start-hrsystem\.ps1|manager)'); if ($mm.Success) { $alt = $mm.Groups[1].Value; break } } catch {} }; if (-not $alt) { $alt = 'C:\HRSystem' }; if (Test-Path (Join-Path $alt 'Dashboard.bat')) { Start-Process -FilePath (Join-Path $alt 'Dashboard.bat'); exit }; Write-Host 'Dashboard-i nuk eshte instaluar: hap Install.bat.'; Start-Sleep -Seconds 5; exit }; Remove-Item $f -Force -ErrorAction SilentlyContinue; $log = Join-Path $root 'Dashboard.log'; $cmd = 'Set-Location ''' + $m + '''; & node server.mjs *>> ''' + $log + ''''; Start-Process powershell.exe -Verb RunAs -WindowStyle Hidden -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-WindowStyle','Hidden','-Command',$cmd; for ($i = 0; $i -lt 30 -and -not (Up); $i++) { Start-Sleep -Seconds 1 } }; if (Up) { Start-Process ((Get-Content $f -Raw).Trim()) } else { Write-Host 'Dashboard-i nuk u hap. Shiko Dashboard.log te folderi i instalimit.'; Start-Sleep -Seconds 6 }"
